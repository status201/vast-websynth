{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "websynth-song-author.schema.json",
  "title": "VAST G1-J8 song authoring dialect (input-only)",
  "description": "Compact, AI-friendly authoring format for the VAST G1-J8 web synthesizer (package name: websynth). On import the app expands this into the full canonical 'websynth-song' format (see websynth-song.schema.json) \u2014 the dialect is INPUT-ONLY and is never exported or persisted. Melody banks are positional note lists (rest-padded to 16 steps), drum/sampler banks are hit lists keyed by track name, and chains are strings like 'AABA'. Canonical runtime validation is src/state/song-author.ts (expandAuthorSong); this schema is the published machine-readable mirror. Note: the runtime normalizes drum-track keys (case/punctuation-insensitive, e.g. 'C.Hat' == 'chat'), which JSON Schema cannot express \u2014 this schema documents keys via additionalProperties and the runtime enforces them.",
  "type": "object",
  "required": [
    "format",
    "version",
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "websynth-song-author",
      "description": "Required discriminator. Always the literal string 'websynth-song-author'."
    },
    "version": {
      "const": 1,
      "description": "Authoring-dialect version. Always 1."
    },
    "name": {
      "type": "string",
      "description": "Human-readable song name."
    },
    "params": {
      "type": "object",
      "description": "SPARSE ParamBus snapshot: dotted parameter id -> scalar value (e.g. 'transport.bpm', 'filter.cutoff'). Set only what matters; every omitted param keeps its default.",
      "additionalProperties": {
        "type": "number"
      }
    },
    "seq": {
      "type": "array",
      "maxItems": 4,
      "description": "0..4 melody banks (A/B/C/D). A missing bank is empty.",
      "items": {
        "$ref": "#/$defs/seqBank"
      }
    },
    "drums": {
      "type": "array",
      "maxItems": 4,
      "description": "0..4 drum banks. Track keys: kick, snare, chat/hat/hihat/closedhat, ohat/openhat, ltom/lowtom, mtom/midtom, htom/hightom, clap, or '0'..'7'.",
      "items": {
        "$ref": "#/$defs/hitBank"
      }
    },
    "sampler": {
      "type": "array",
      "maxItems": 4,
      "description": "0..4 sampler banks. Slot keys: 's1'..'s8' or '0'..'7'. Slots play user-loaded audio; audio is never embedded.",
      "items": {
        "$ref": "#/$defs/hitBank"
      }
    },
    "motion": {
      "type": "array",
      "maxItems": 4,
      "description": "0..4 motion-sequencer banks: XY param automation over the bar. Each bank is an anchor list, or {assign, steps} to override which two params this bank drives (an unset axis inherits 'xy'). 'motion.slide' param: 1 (default) ramps linearly between anchors, 0 jumps and holds.",
      "items": {
        "$ref": "#/$defs/motionBank"
      }
    },
    "seqChain": {
      "$ref": "#/$defs/seqChain",
      "description": "Sequencer arrangement lane. Omitted = play bank A (chain disabled). A bank letter may carry a transpose: 'A A+5 A+7 A+3'."
    },
    "drumChain": {
      "$ref": "#/$defs/chain",
      "description": "Drum arrangement lane."
    },
    "samplerChain": {
      "$ref": "#/$defs/chain",
      "description": "Sampler arrangement lane."
    },
    "motionChain": {
      "$ref": "#/$defs/chain",
      "description": "Motion arrangement lane."
    },
    "motionTracks": {
      "type": "array",
      "maxItems": 4,
      "description": "0..4 banks, each 0..2 extra single-param motion tracks. Each track picks one ParamBus id and its own anchors, so a bank can automate up to 4 params (the XY pair plus these two). Use null for an unused track.",
      "items": {
        "type": "array",
        "maxItems": 2,
        "items": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "param": {
                  "type": "string",
                  "minLength": 1,
                  "description": "ParamBus id this track drives, e.g. 'fx.delay.mix'."
                },
                "steps": {
                  "type": "array",
                  "description": "Anchors: { step: 0..15, v: 0..1 }. Unlisted steps are not anchors.",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "step",
                      "v"
                    ],
                    "properties": {
                      "step": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 15
                      },
                      "v": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "sampleNames": {
      "type": "array",
      "maxItems": 8,
      "description": "Display name per sampler slot (padded to 8 with null). Filenames only \u2014 the user loads the audio by hand.",
      "items": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "xy": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "description": "XY-pad axis assignment: which param each pad axis drives.",
      "properties": {
        "x": {
          "type": "string",
          "minLength": 1
        },
        "y": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "seqTranspose": {
      "type": "array",
      "maxItems": 1024,
      "description": "Per-slot semitone offsets for 'seqChain', parallel to its slots \u2014 the explicit form of the chain string's '+n' suffix, for when the chain is written as an array or object. Omit it (or leave every entry 0) for a song that does not transpose.",
      "items": {
        "type": "integer",
        "minimum": -24,
        "maximum": 24
      }
    }
  },
  "$defs": {
    "note": {
      "description": "A pitch: MIDI number 0..127 or a note name like 'A2'/'C#4'/'Db3' (C4 = 60).",
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 127
        },
        {
          "type": "string",
          "pattern": "^[A-Ga-g][#b]?-?\\d+$"
        }
      ]
    },
    "stepSettings": {
      "velocity": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "gate": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "prob": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "ratchet": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4
      },
      "tie": {
        "type": "boolean"
      },
      "micro": {
        "type": "integer",
        "minimum": -12,
        "maximum": 12,
        "description": "Micro-timing: integer -12..12 in 1/24 of the step's own cell. Negative = early, positive = late. Default 0."
      }
    },
    "seqEntry": {
      "description": "One melody step: null = rest, a note, or a note object with per-step settings. Sounded-step defaults: velocity 0.85, gate 0.5, prob 1, ratchet 1, tie false, micro 0.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/note"
        },
        {
          "type": "object",
          "required": [
            "note"
          ],
          "properties": {
            "note": {
              "$ref": "#/$defs/note"
            },
            "velocity": {
              "$ref": "#/$defs/stepSettings/velocity"
            },
            "gate": {
              "$ref": "#/$defs/stepSettings/gate"
            },
            "prob": {
              "$ref": "#/$defs/stepSettings/prob"
            },
            "ratchet": {
              "$ref": "#/$defs/stepSettings/ratchet"
            },
            "tie": {
              "$ref": "#/$defs/stepSettings/tie"
            },
            "micro": {
              "$ref": "#/$defs/stepSettings/micro"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "seqBank": {
      "description": "One bar of melody (16 sixteenth-note steps): a positional entry array (short arrays are rest-padded), the bank-defaults form {notes, ...settings} where the settings apply to every sounded step, or {tracks: [...], ...settings} for up to 4 simultaneous tracks (chords/counter-lines; tracks 2-4 need poly voicing). Settings cascade bank -> track -> step, nearest wins.",
      "oneOf": [
        {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/seqEntry"
          }
        },
        {
          "type": "object",
          "required": [
            "notes"
          ],
          "properties": {
            "notes": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/seqEntry"
              }
            },
            "velocity": {
              "$ref": "#/$defs/stepSettings/velocity"
            },
            "gate": {
              "$ref": "#/$defs/stepSettings/gate"
            },
            "prob": {
              "$ref": "#/$defs/stepSettings/prob"
            },
            "ratchet": {
              "$ref": "#/$defs/stepSettings/ratchet"
            },
            "tie": {
              "$ref": "#/$defs/stepSettings/tie"
            },
            "micro": {
              "$ref": "#/$defs/stepSettings/micro"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "tracks"
          ],
          "additionalProperties": false,
          "properties": {
            "tracks": {
              "type": "array",
              "maxItems": 4,
              "description": "Up to 4 note lists played together. The first is track 1 (the plain form above); tracks 2-4 only sound in poly voicing.",
              "items": {
                "$ref": "#/$defs/seqBank"
              }
            },
            "velocity": {
              "$ref": "#/$defs/stepSettings/velocity"
            },
            "gate": {
              "$ref": "#/$defs/stepSettings/gate"
            },
            "prob": {
              "$ref": "#/$defs/stepSettings/prob"
            },
            "ratchet": {
              "$ref": "#/$defs/stepSettings/ratchet"
            },
            "tie": {
              "$ref": "#/$defs/stepSettings/tie"
            },
            "micro": {
              "$ref": "#/$defs/stepSettings/micro"
            }
          }
        }
      ]
    },
    "hit": {
      "description": "One trigger: a step index 0..15 or a step object with per-step settings.",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        {
          "type": "object",
          "required": [
            "step"
          ],
          "properties": {
            "step": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "velocity": {
              "$ref": "#/$defs/stepSettings/velocity"
            },
            "gate": {
              "$ref": "#/$defs/stepSettings/gate"
            },
            "prob": {
              "$ref": "#/$defs/stepSettings/prob"
            },
            "ratchet": {
              "$ref": "#/$defs/stepSettings/ratchet"
            },
            "tie": {
              "$ref": "#/$defs/stepSettings/tie"
            },
            "micro": {
              "$ref": "#/$defs/stepSettings/micro"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "hitBank": {
      "type": "object",
      "description": "One bar of triggers: track/slot key -> hit list. The runtime validates the keys (drum aliases or 's1'..'s8'/'0'..'7').",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/hit"
        }
      }
    },
    "motionAnchor": {
      "type": "object",
      "description": "One motion anchor: the assigned params' normalized 0..1 positions at a step (taper space, like the XY pad surface).",
      "required": [
        "step",
        "x",
        "y"
      ],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "motionBank": {
      "description": "One bar of XY automation: an anchor list, or {assign, steps} to override the driven params per bank.",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/motionAnchor"
          }
        },
        {
          "type": "object",
          "required": [
            "steps"
          ],
          "properties": {
            "assign": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "string",
                  "minLength": 1
                },
                "y": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "steps": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/motionAnchor"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "chain": {
      "description": "Arrangement lane, one bank per bar, looped: a bank-letter string ('.'/'-' = silent bar, spaces ignored), an index array (-1 = silent bar), or the full {enabled, steps} object. String/array shorthands imply enabled: true.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Da-d.\\s-]+$",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": -1,
            "maximum": 3
          }
        },
        {
          "type": "object",
          "required": [
            "enabled",
            "steps"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": -1,
                "maximum": 3
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "seqChain": {
      "description": "The sequencer's arrangement lane. Everything $defs/chain allows, plus a per-slot transpose: a bank letter may carry '+n'/'-n' semitones (max 24), as in 'A A+5 A+7 A+3' \u2014 so one bank can play a whole chord progression. A suffix on a rest is an error, and only this lane accepts one. The array and object forms take the parallel 'seqTranspose' key instead.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\s*([A-Da-d.-]([+-]\\d{1,2})?\\s*)+$",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": -1,
            "maximum": 3
          }
        },
        {
          "type": "object",
          "required": [
            "enabled",
            "steps"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "steps": {
              "oneOf": [
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": -1,
                    "maximum": 3
                  }
                },
                {
                  "type": "string",
                  "pattern": "^\\s*([A-Da-d.-]([+-]\\d{1,2})?\\s*)+$",
                  "minLength": 1
                }
              ]
            }
          }
        }
      ]
    }
  }
}
