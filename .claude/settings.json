{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && node scripts/sdd-guard.mjs remind" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && node scripts/sdd-guard.mjs pretool" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && node scripts/sdd-guard.mjs stop" },
          { "type": "command", "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && node scripts/spec-lint.mjs hook" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && node scripts/sdd-guard.mjs stop" },
          { "type": "command", "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && node scripts/spec-lint.mjs hook" }
        ]
      }
    ]
  }
}
