{
  "name": "websynth",
  "version": "2.11.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host",
    "prebuild": "npm run clean:demos && npm run gen:params",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "build:mcp": "vite build --config scripts/mcp/vite.lib.config.ts",
    "start:mcp:http": "node scripts/mcp/websynth-mcp-http.mjs",
    "pack:mcp": "node scripts/pack-mcp.mjs",
    "clean:demos": "vitest run --config scripts/clean-demos.config.ts",
    "check:demos": "vitest run --config scripts/check-demos.config.ts",
    "gen:params": "vitest run --config scripts/gen-params.config.ts",
    "check:params": "vitest run --config scripts/check-params.config.ts",
    "spec:lint": "node scripts/spec-lint.mjs",
    "bench:audio": "node scripts/audio-bench.mjs",
    "bench:metrics": "node scripts/audio-metrics.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
